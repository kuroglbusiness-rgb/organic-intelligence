# --- Zernio (passerelle Instagram + CAPI) ---
# À récupérer dans le dashboard Zernio après connexion de ton compte Instagram
ZERNIO_API_KEY=
# Secret utilisé par Zernio pour signer ses webhooks (HMAC). Généré dans Zernio > Webhooks.
ZERNIO_WEBHOOK_SECRET=

# --- Supabase (base Postgres gratuite) ---
# Settings > API dans ton projet Supabase
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Settings > API > service_role key (jamais exposée au front, utilisée seulement côté serveur)
SUPABASE_SERVICE_ROLE_KEY=

# --- Domaine ---
# Le sous-domaine que tu pointes vers Vercel pour les Smart Links (ex. track.kurotrd.com)
BASE_URL=https://track.kurotrd.com

# --- Sécurité des webhooks entrants de tes landings externes (Calendly, Typeform, Make...) ---
# Choisis une longue chaîne aléatoire toi-même, à mettre aussi dans le paramètre ?key= de tes webhooks entrants
LANDING_WEBHOOK_SECRET=
